# TrueMed Backend API — environment template
# "Truth in Every Medicine" · हर दवा में सच्चाई
#
# Copy to .env and edit:  cp .env.example .env
# Load it with Node itself — there is no dotenv dependency:
#     node --env-file=.env src/server.js
#
# Every variable below is optional in development; the defaults shown are the
# ones the code uses. In production several of them become required, and three
# development-only switches (FABRIC_MOCK, TRUST_REQUIRE_SIGNATURE,
# SENSOR_REQUIRE_HMAC) will refuse to let the process start if left unsafe.
#
# NEVER commit a filled-in .env. It is listed in .gitignore for that reason.

# ─── Runtime ────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Set to 1 ONLY when a reverse proxy (nginx, load balancer) is actually in front
# of this service. It makes the app trust X-Forwarded-For for the client IP,
# which rate limiting and report geography depend on. Enabling it with no proxy
# lets any client spoof its IP; leaving it off behind a proxy makes every request
# look like it came from the proxy, so one abusive client rate-limits everyone.
TRUST_PROXY=0

# Counterfeit reports carry a JPEG as base64, which inflates size by about a third.
BODY_LIMIT=2mb
SHUTDOWN_GRACE_MS=10000

# Comma-separated browser origins for the dashboards. Empty means no cross-origin
# browser access, which is correct for a mobile-first API. "*" is refused in production.
# CORS_ORIGINS=http://localhost:3000,https://cdsco-dashboard.example.in

# ─── Logging ────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent   ("silent" is refused in production)
LOG_LEVEL=info
# 1 = human-readable colour output, 0 = one JSON object per line for log shippers.
# Defaults to 1 outside production.
LOG_PRETTY=1

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# Required in production. The literal "changeme" below is rejected in production,
# so an unedited copy of this file cannot be deployed by accident.
DATABASE_URL=postgres://truemed:changeme@localhost:5432/truemed
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
# Must exceed DB_CONNECT_TIMEOUT_MS. Caps any single query so one slow dashboard
# report cannot exhaust the pool and take patient verification down with it.
DB_STATEMENT_TIMEOUT_MS=10000
DB_SSL=0
# Postgres in docker-compose usually is not accepting connections yet when the
# API starts, so the first connection is retried rather than crash-looping.
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=1000

# ─── Redis (cache only, never a source of truth) ─────────────────────────────
# The API runs correctly with Redis down or disabled — it just gets slower,
# because every verification then reaches the blockchain.
REDIS_ENABLED=1
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000

# ─── Hyperledger Fabric ─────────────────────────────────────────────────────
# 1 = in-memory mock ledger, so the API, mobile app and dashboards can be
# developed and demonstrated without a running Fabric network.
#
# This MUST be 0 in production, and the process refuses to start otherwise:
# mock mode would answer GENUINE for medicine that was never on the chain.
FABRIC_MOCK=1

# 1 = build a demo world during startup, before the port is bound, and print the
# API keys it issued. Read directly by src/server.js rather than by the config
# loader, because it changes what the process does on boot rather than how it is
# configured.
#
# It has to happen inside the server process: with FABRIC_MOCK=1 the ledger, the
# database and the cache are objects in one heap and the mock ledger has no file
# behind it, so anything `npm run seed` wrote as a separate process would vanish
# when it exited — keys included. seedDemo() refuses to run in production.
SEED_DEMO=0

FABRIC_CHANNEL=truemed-channel
FABRIC_CHAINCODE=truemed
# ManufacturerMSP | DistributorMSP | RegulatorMSP
FABRIC_MSP_ID=ManufacturerMSP
FABRIC_PEER_ENDPOINT=localhost:7051
# The peer's TLS certificate names it peer0.manufacturer.truemed.in while the
# endpoint is localhost:7051. This alias makes the gRPC handshake succeed without
# turning certificate verification off.
FABRIC_PEER_HOST_ALIAS=peer0.manufacturer.truemed.in

# Required when FABRIC_MOCK=0. Paths may be relative to the backend directory.
# FABRIC_TLS_CA_PATH=../blockchain/network/crypto-config/peerOrganizations/manufacturer.truemed.in/tlsca/tlsca.manufacturer.truemed.in-cert.pem
# FABRIC_CERT_PATH=../blockchain/network/crypto-config/peerOrganizations/manufacturer.truemed.in/users/User1@manufacturer.truemed.in/msp/signcerts/cert.pem
# FABRIC_KEY_PATH=../blockchain/network/crypto-config/peerOrganizations/manufacturer.truemed.in/users/User1@manufacturer.truemed.in/msp/keystore/priv_sk

FABRIC_EVALUATE_TIMEOUT_MS=5000
# Submitting waits for ordering and commit, so it needs a larger budget than a read.
FABRIC_SUBMIT_TIMEOUT_MS=15000

# ─── Trust bundle (manufacturer signing keys) ───────────────────────────────
# Produced by the qr-generator component and served by GET /api/public-keys so
# the mobile app can verify signatures offline.
TRUST_BUNDLE_PATH=keys/trust-bundle.json
TRUST_ROOT_PUBLIC_KEY_PATH=keys/root-public.pem

# The bundle is signed by an offline root key. Verifying that signature is what
# makes compromising this API server insufficient to insert an attacker's signing
# key. Refused in production if 0.
TRUST_REQUIRE_SIGNATURE=1
# How often to re-read the bundle from disk, so adding a manufacturer key does
# not need a restart. 0 disables reloading.
TRUST_RELOAD_INTERVAL_MS=300000

# ─── IoT temperature sensors ────────────────────────────────────────────────
# Readings are signed with HMAC-SHA256 over
#   product_id|sensor_id|temperature|recorded_at|nonce
# using the sensor's shared secret, so a stolen API key alone cannot fabricate a
# clean cold-chain history for spoiled vaccines. Refused in production if 0.
SENSOR_REQUIRE_HMAC=1
# Nonces are remembered this long to reject replayed readings (24 h).
SENSOR_NONCE_TTL_S=86400
SENSOR_MAX_CLOCK_SKEW_MS=900000

# ─── Rate limits ────────────────────────────────────────────────────────────
# Public endpoints are unauthenticated by design — a patient must never need an
# account to check a medicine — so these are keyed by IP.
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTHED_PER_MIN=600
# Reports are cheap to submit and expensive to triage, and each carries a photo.
RATE_LIMIT_REPORT_PER_HOUR=10
RATE_LIMIT_SENSOR_PER_MIN=120
