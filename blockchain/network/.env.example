# TrueMed Fabric network — environment template.
#
# Copy to .env before starting the network:
#
#     cp .env.example .env
#
# .env is git-ignored. This file is committed and must never contain a real
# secret. If you paste a password into .env.example by mistake, treat it as
# compromised and rotate it: the file is in git history from that moment on.
#
# Docker Compose reads .env automatically from the directory holding
# docker-compose.yaml. It is not read by the scripts in scripts/, which source
# .env explicitly.

# ── Image versions ───────────────────────────────────────────────────────────
# Pinned, not :latest. A silent minor-version bump between your last working
# demo and the presentation is a failure mode with no error message: the peer
# simply refuses to join a channel whose capabilities it does not recognise.
FABRIC_VERSION=2.5.9
FABRIC_CA_VERSION=1.5.12
COUCHDB_VERSION=3.3.3

# ── CouchDB credentials ──────────────────────────────────────────────────────
# The state database holds every medicine record on the channel. Anyone who can
# reach port 5984 with these credentials can read the entire ledger state and, if
# they are careless enough, write to it — CouchDB will not stop them, and the peer
# will not notice until a block fails to validate.
#
# Generate a fresh password rather than inventing one:
#
#     openssl rand -base64 24
#
# Use a DIFFERENT value per environment. The one on your laptop must not be the
# one on the Oracle VM.
COUCHDB_USER=truemed_admin
COUCHDB_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────────────────
# INFO for normal use. When a transaction is being rejected and the reason is not
# obvious, DEBUG on the peer is what tells you which endorsement policy failed:
#
#     FABRIC_LOGGING_SPEC=info:endorser=debug:vscc=debug:gossip=warn
FABRIC_LOGGING_SPEC=INFO

# ── Network identity ─────────────────────────────────────────────────────────
# CHANNEL_NAME must be lowercase alphanumeric with dots or dashes, start with a
# letter, and be 250 characters or fewer — Fabric rejects anything else, with an
# error that mentions a regex rather than the rule.
CHANNEL_NAME=truemed
CHAINCODE_NAME=truemed
CHAINCODE_VERSION=1.0
CHAINCODE_SEQUENCE=1

# The docker network name is fixed in docker-compose.yaml rather than derived
# from the project name, because the peers pass it to the Docker daemon when they
# launch chaincode containers. If it does not match, chaincode starts and then
# cannot be reached, which surfaces as a timeout during "peer lifecycle chaincode
# commit" with nothing useful in the peer log.
DOCKER_NETWORK=truemed_net
